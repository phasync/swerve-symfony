{
    "name": "phasync/swerve-symfony",
    "description": "Run Symfony applications on swerve: booted once per worker, WebSockets and Server-Sent Events, no rewrite.",
    "type": "library",
    "license": "MIT",
    "keywords": ["symfony", "swerve", "phasync", "application server", "long-running", "psr-15", "websocket"],
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "phasync/phasync": "^2.0.0-beta6",
        "phasync/swerve": "^0.1.0-beta3",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/runtime": "^6.4 || ^7.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0 || ^4.0",
        "friendsofphp/php-cs-fixer": "^3.58"
    },
    "suggest": {
        "phasync/phasync-ext": "Symfony's database and HTTP calls wait cooperatively under it, so the kernel pool can serve overlapping requests from one worker instead of a slow request stalling the others; works fully without it."
    },
    "autoload": {
        "psr-4": {
            "Swerve\\Symfony\\": "src/"
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest --stop-on-defect",
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix --verbose",
        "php-cs-fixer-dry-run": "vendor/bin/php-cs-fixer fix --verbose --diff --dry-run"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "symfony/runtime": true
        }
    }
}
